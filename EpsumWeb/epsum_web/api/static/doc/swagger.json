    "/case_studies/create_case_study/": {
      "post": {
        "tags": [
          "Case Studies"
        ],
        "summary": "Create New Case Study",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "AI Optimization in Steel Manufacturing"
                  },
                  "slug": {
                    "type": "string",
                    "example": "ai-optimization-steel-manufacturing"
                  },
                  "industry": {
                    "type": "integer",
                    "example": "2"
                  },
                  "case_study_status": {
                    "type": "string",
                    "example": "Published"
                  },
                  "company_name": {
                    "type": "string",
                    "example": "Tata Steel"
                  },
                  "overview": {
                    "type": "string",
                    "example": "This case study explores how AI improved efficiency in steel production."
                  },
                  "cover_image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "challenges": {
                    "type": "string",
                    "example": "High energy consumption and inconsistent output quality."
                  },
                  "solutions": {
                    "type": "string",
                    "example": "Implemented predictive analytics and real-time monitoring."
                  },
                  "results": {
                    "type": "string",
                    "example": "Reduced energy consumption by 20% and improved output consistency."
                  },
                  "key_metrics": {
                    "type": "string",
                    "example": "{\n\"energy_reduction\": \"20%\",\n\"cost_savings\": \"15%\",\n\"downtime_reduction\": \"30%\"\n}"
                  },
                  "meta_desc": {
                    "type": "string",
                    "example": "AI-driven optimization in steel manufacturing improving efficiency and reducing costs."
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
